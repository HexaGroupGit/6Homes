# Normalise line endings so the repo is identical whichever OS commits to it.
* text=auto eol=lf

# Binary — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated: keep them out of diffs and language stats.
package-lock.json  linguist-generated=true -diff
site/public/media/**   linguist-vendored=true
site/public/brand/**   linguist-vendored=true
