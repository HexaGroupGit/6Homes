# ── Supabase ────────────────────────────────────────────────────────────────
# Server side (api/ functions). The service role bypasses RLS — never expose it
# to the browser and never prefix it with VITE_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser side (the admin SPA). Anon key + a signed-in admin session.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Resend ──────────────────────────────────────────────────────────────────
# Leave unset to disable sending entirely (every send returns skipped:'no_key').
# Remember: safe mode in Settings still gates delivery even once this is set.
RESEND_API_KEY=

# ── Cron ────────────────────────────────────────────────────────────────────
# Vercel cron calls arrive as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# ── Links used inside emails ────────────────────────────────────────────────
PUBLIC_SITE_URL=https://6homes.com
ADMIN_URL=https://admin.6homes.com
