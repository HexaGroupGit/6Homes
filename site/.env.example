# Where website enquiries are forwarded. Point this at a Vercel preview URL when
# staging the admin, otherwise leave it at production.
SIXHOMES_ADMIN_ENDPOINT=https://admin.6homes.com/api/form-submit

# ── Supabase (the 6Homes CRM project) ───────────────────────────────────────
# Anon key + read-only RLS: the site can only read designs and projects that are
# marked published.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service key — used ONLY by the enquiry fallback path, to write a lead directly
# if the admin endpoint is unreachable. Never exposed to the browser.
CRM_SUPABASE_SERVICE_KEY=

# Canonical site URL, used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://6homes.com
